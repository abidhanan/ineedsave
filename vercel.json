{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "installCommand": "npm install",
  "buildCommand": "node scripts/build.mjs",
  "functions": {
    "api/extract.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,public/**,templates/**,scripts/**}"
    },
    "api/download.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
